DATABASE_URL=postgres://postgres:postgres@localhost:5432/webanalytics
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-0000000
PORT=3000
# Only needed if the dashboard is hosted on a different origin (e.g. Vercel)
CLIENT_ORIGIN=
# Set to true for managed Postgres that requires SSL
PGSSL=false
